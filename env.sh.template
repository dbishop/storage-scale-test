# Get absolute path to script directory
SCALE_TEST_BASE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

########### vvvvvvvvvv ONLY EDIT THESE vvvvvvvvvv ######################

# Set the directories for capturing the results
export RESULTS_DIR="${HOME}/results"
export LOGS_DIR="${HOME}/logs"

# Select exactly one execution substrate. There is intentionally no default:
# uncomment one value and configure its section below.
#export EXECUTION_SUBSTRATE=slurm  # slurm, ssh, or kubectl

# When enabled, node selection becomes deterministic: SSH mode uses the
# first N hosts from the host file (instead of random selection), and
# Slurm mode (when SLURM_NODE_INCLUDES is set) restricts each job to
# exactly the first N nodes from the include list.
ORDER_NODES=0

############ SSH-based testing ############
# If EXECUTION_SUBSTRATE=ssh and your nodes are reachable through passwordless
# SSH, configure the following variables. SSH_HOST_LIST does not select the
# execution substrate.
#
# The SSH_HOST_LIST should be a file with a list of hostnames or IP
# addresses of nodes which can be reached via passwordless ssh, by the
# SSH_USER (defaults to invoking user).  It can use multiple lines, and
# on each line, the values may be space or comma-separated.  Lines
# starting with /^\s*#/ are ignored.
#
# In SSH mode, the following Slurm variables are ignored:
#  account
#  reservation
#  partition
#  run_time
#  MODULES
#  SLURM_NODE_IGNORES
#
#export SSH_HOST_LIST=/path/to/host/list
#export SSH_USER="$(whoami)"  # Set if you want to override default ssh user (from ssh config etc)
#export SSH_HOMEDIR_SHARED=  # set to anything if target hosts share a homedir
########## END SSH-based testing variables############


############ Kubernetes-based filesystem testing ############
# kubectl must already be authorized for the intended cluster. Namespace,
# storage, and selected worker nodes are prerequisites; this tool does not
# provision them. Selected Pods must have ordinary cross-node IPv4 reachability
# on TCP port 1611. TEST_DIRS remain logical paths; the sweep prepends its fixed
# PVC mount, /mnt/storage-scale-test/, inside Kubernetes Pods.
export KUBECTL_NAMESPACE=
export KUBECTL_PV=
export KUBECTL_PVC=
export KUBECTL_NODE_SELECTOR=
export KUBECTL_ELBENCHO_IMAGE=breuner/elbencho:v3.1-11
export KUBECTL_IMAGE_PULL_POLICY=IfNotPresent
export KUBECTL_RUN_AS_USER=2000
export KUBECTL_RUN_AS_GROUP=2000
# A kubectl sweep returns after submitting its in-cluster Job. Use the printed
# --status, --cancel, and --collect commands. A failed or cancelled attempt must
# be collected before --resume can construct a new attempt from durable state.
########## END Kubernetes-based testing variables############


############ SLURM-based testing ############
# Set SLURM account/reservation/partition details
account=""
reservation=""
partition=""
# Slurm job args
run_time="6-00:00:00"
SLURM_JOB_NAME_PREFIX=""
# With SLURM_EXTRA_ARGS, you can add any additional arguments to sbatch/srun commands.
# NOTE: you can easily break things by adding invalid arguments.
SLURM_EXTRA_ARGS=()
# If set to 1/yes/true, the sbatch --exclusive flag becomes --exclusive=user,
# allowing other jobs from the SAME user to share nodes (but still excluding
# other users' jobs).  When enabled, --cpus-per-task is automatically derived
# from the target nodes via sinfo so that the cgroup cpuset is not restricted
# to a single core (--exclusive=user does not implicitly allocate all CPUs).
SLURM_EXCLUSIVE_USER=0

# Add any modules, specific to this environment here; they will be
# checked for availability before attempting to load them.
MODULES=()

# An optional file of slurm client node names (in any valid slurm
# hostlist format, e.g. "node001,node002" or "node[001-002]"), one entry
# per line (blank lines ignored).  If present, the listed nodes will be
# excluded from slurm jobs.  Useful for pruning statistically-
# significantly underperforming nodes from scale testing.
# Not in the filesystem-specific section in case it's also useful to
# sometimes exclude nodes from object or block tests.
export SLURM_NODE_IGNORES=~/.slurm_node_ignores

# An optional file of slurm client node names (same format as above) to
# RESTRICT jobs to.  If present and non-empty, its contents are passed
# as --nodelist to sbatch/srun so that only the listed nodes are eligible
# for scheduling.
export SLURM_NODE_INCLUDES=~/.slurm_node_includes
########## END SLURM-based testing variables############



# Client type ("cpu" or "gpu"). Use "gpu" on GPU client nodes / GPU-only
# partitions so SBATCH/SRUN (and validate_env srun scale) request GRES.
client_type="cpu"
client_arch="x86_64"  # or "aarch64" for Grace or other ARM chips

# FILESYSTEM TEST VARIABLES (add entries to TEST_DIRS to enable filesystem testing!)
#
# The filesystems to test, with relative weights. The weights determine load distribution.
# Example: TEST_DIRS=(["/path/to/fs1"]=1 ["/path/to/fs2"]=2)
# In the example, fs2 would get twice the load of fs1 (2/3 vs 1/3 of total load)
declare -A TEST_DIRS
# Default is empty - add entries to enable filesystem testing
TEST_DIRS=()

# Estimated maximum aggregate filesystem(s)' throughput in GB/s
#
# If the write and read max aggregate bandwidths differ, use the larger
# of the two here). This is used when we need to determine a file-count,
# at a certain file size, and we want the resulting run-time to be at
# least roughly bounded.
#
export FS_MAX_AGG_THROUGHPUT=50   # Units are GB/s
# Update these per-node numbers with single-node data
export FS_MAX_NODE_THROUGHPUT_GBPS=40  # Units are Gbps
export FS_MAX_NODE_IOPS=10000

# MDTEST-elbencho (recommended)
#
# Directory structure created:
#   <TEST_DIRS>/mdtest-elbencho-target-N/b{0..MDTEST_BRANCH_FACTOR-1}/r{rank}/d{dir}/
#   Depth from TEST_DIRS: 4 levels (b{i} + r{rank} + d{dir} + files)
#
# NOTE: On filesystems with scale-out metadata servers/processes, verify
# MDTEST_BRANCH_FACTOR is sufficient to spread load across them. If the filesystem
# distributes new directories round-robin only up to a fixed tree depth, make
# sure the created tree (depth 4 from TEST_DIRS) is deeper than that limit.
#
# Derived counts (PER TASK):
#   DIRS_PER_THREAD = MDTEST_BRANCH_FACTOR ** 2
#   FILES_PER_TASK  = MDTEST_BRANCH_FACTOR ** 2 * MDTEST_ITEMS_PER_DIR
#
# With defaults of factor=7, items_per_dir=100:
#   DIRS_PER_THREAD = 49
#   FILES_PER_TASK  = 4,900
#
# Branched layout only. For one shared flat directory, use
# --single-dir-file-target (requires a single TEST_DIRS entry with weight 1).
#
export MDTEST_BRANCH_FACTOR=7
export MDTEST_ITEMS_PER_DIR=100
export MDTEST_ITERATIONS=3

# ELBENCHO
# Thread counts to test in the IO size/threads sweep tests
export ELBENCHO_SCALE_THREAD_LIST=("1" "2" "4" "8" "16" "32" "64" "128" "256")
# Multiplier applied to the IO size to determine the file size (default: 1024)
# Example: with IO size 4K and multiplier 1024, file size = 4K * 1024 = 4M
export ELBENCHO_FILE_SIZE_MULTIPLIER=1024
# Generated many-file layout. The default preserves the historical directory
# tree. For a bounded checkpoint-like workload in one shared directory, set:
#   ELBENCHO_FILE_LAYOUT=shared-directory
#   ELBENCHO_FILES_PER_NODE=8
#   ELBENCHO_FILE_SIZE=64G
# ELBENCHO_FILES_PER_NODE is the total file count on each participating node.
# Each ELBENCHO_SCALE_THREAD_LIST value selects the maximum concurrently active
# files per node. Each worker owns complete files and processes
# ELBENCHO_FILES_PER_NODE divided by that thread count, so the file count must
# be at least and evenly divisible by every configured thread count. To model
# one file from each single-threaded saving rank, set both values to the
# saving-rank count per node. This mode does not model multiple writer threads
# sharing one file. Each ELBENCHO_IODEPTH_LIST value selects concurrent block
# I/Os per worker, not writer threads.
# ELBENCHO_FILE_SIZE is optional; when unset, ELBENCHO_FILE_SIZE_MULTIPLIER
# determines the generated file size. These controls do not redefine a staged
# --read-from tree.
export ELBENCHO_FILE_LAYOUT=worker-directories
export ELBENCHO_FILES_PER_NODE=
export ELBENCHO_FILE_SIZE=
# IO sizes to test. Format: [r]<SIZE> or [r]<WRITE_SIZE>,[r]<READ_SIZE>
# Single size (4M files): "4K" (seq/rand from CLI), "r4K" (force random)
# Split size (1G files): "1M,4K" (seq/rand from CLI), "r1M,4K" (random writes),
#                        "1M,r4K" (random reads), "r1M,r4K" (force both random)
export ELBENCHO_SCALE_IO_SIZES=("r4K" "r16K" "r64K" "1M" "1M,4K")
# Duration for read/write tests in seconds
export ELBENCHO_IODEPTH_LIST=()  # default is to only always use 1
export ELBENCHO_SCALE_READ_WRITE_DURATION=60
export ELBENCHO_READ_AFTER_WRITE_PAUSE=0  # seconds to pause between write and read phases
#
# Optional extended live CSV capture. Disabled by default.
# ELBENCHO_LIVE_CSV_EXTENDED=1 adds native --livecsv and --livecsvex: each interval
# contains one aggregate Rank=Total row plus one row per service in SSH/multi-node
# Slurm runs (normally one service per host), or per worker thread in single-node Slurm.
# Extended rows contain cumulative DoneBytes, so throughput is derived from deltas.
# ELBENCHO_LIVEINT maps to native --liveint and controls the interval in milliseconds.
# At large node counts capture can produce hundreds of MB to GB per hour.
export ELBENCHO_LIVE_CSV_EXTENDED=0
export ELBENCHO_LIVEINT=1000
#
# Single shared large file (elbencho regular-file path mode; sequential I/O only).
# Mutually exclusive with random IO (-r / --rand on the sweep, or "r" in ELBENCHO_SCALE_IO_SIZES).
# Requires exactly one TEST_DIRS key. Paths use generate_fs_test_directories + basename unless --read-from overrides.
# export ELBENCHO_SINGLE_BIG_FILE=0
# export ELBENCHO_SINGLE_BIG_FILE_BASENAME=elbencho-bigfile
# export ELBENCHO_SINGLE_BIG_FILE_SIZE=   # required for write/default single-big-file sweeps; optional for nv-elbencho-sweep.sh --read-from (read omits --size; extent from file)
# export ELBENCHO_ALL_NODES_ACCESS_ALL_DATA=0  # 1 → every node reads/writes the full file (not just its slice)


# OBJECT TEST VARIABLES (set OBJ_BUCKET to enable object testing!)
#
# The bucket to use for tests; must already exist!
export OBJ_BUCKET=""
export OBJ_REGION="us-west-2"
export OBJ_HOST="s3.${OBJ_REGION}.amazonaws.com"
export OBJ_HOST_PORT=443
# This file should exist with mode 0400 and contain
#   export WARP_ACCESS_KEY="..."
#   export WARP_SECRET_KEY="..."
export OBJ_AUTH_FILE="${SCALE_TEST_BASE}/.obj_auth"
#
# Optional limits on the number of PUT/GET requests per second across
# whole test.  If not set, there is no limit.
export WARP_RPS_BUDGET_PUT=
export WARP_RPS_BUDGET_GET=
# Set to a comma-separated list of static prefixes to use (the default is to
# use one random prefix name per thread). This requires static-prefix support
# from the NVIDIA Warp fork: https://github.com/NVIDIA/warp-minio
export WARP_PREFIXES=
#
# WARP configuration (same parameters for single-node and multi-node runs)
export WARP_THREAD_LIST=(8 32 64 128 256)
export WARP_OBJ_SIZES=("4MiB" "8MiB" "16MiB" "32MiB" "64MiB")
export WARP_PUT_DURATION=3m
export WARP_PUT_MIN_FILES_PER_CLIENT=10000
export WARP_GET_DURATION=5m
#
# Settings for ranged-read tests; the below value is used for actual PUT
# object size, and then the above "OBJ_SIZES" values are used for the
# `--range-size` argument to warp.
# The number of PUT objects of this size will be equal to the number of
# nodes in the test.
export WARP_RANGE_OBJ_SIZE=5GiB

# NETBENCH TEST VARIABLES (network performance testing with elbencho)
#
# Netbench tests network performance between nodes using TCP connections.
# Uses elbencho's --netbench mode with coordinator/service pattern.
#
# Runtime normalization:
#   The per-thread transfer size is calculated to achieve TARGET_RUNTIME seconds
#   when saturating a HOST_NIC_GBPS link. Formula:
#     per_host_bytes = TARGET_RUNTIME × HOST_NIC_GBPS × 125,000,000
#     per_thread_bytes = per_host_bytes / thread_count
#   As thread count increases, per-thread size decreases, keeping runtime constant.
#   Smaller thread counts that don't saturate the NIC will run longer than TARGET_RUNTIME.
#
export NETBENCH_HOST_NIC_GBPS=100       # Host NIC speed in Gbps (e.g., 100, 200, 400)
export NETBENCH_TARGET_RUNTIME=10       # Target runtime in seconds per benchmark
export NETBENCH_PORT=12865              # Service port (data port = port + 1000)
export NETBENCH_BLOCKSIZE="1M"          # Bytes sent per request
export NETBENCH_RESPSIZE="4K"           # Bytes returned per response
#
# Thread counts to sweep (similar to ELBENCHO_SCALE_THREAD_LIST)
# Each thread opens one TCP connection to a server
export NETBENCH_THREADS=("4" "8" "16" "32")
#
# Number of iterations for statistical variation; nodes in each set are shuffled
# between iterations.
export NETBENCH_ITERATIONS=3

########### ^^^^^^^^^^ ONLY EDIT THESE ^^^^^^^^^^ ######################

# Load the rest of env.sh that shouldn't differ between slurm
# environments (separate file makes incorporating changes into
# any specific cluster easier).

# shellcheck disable=SC1091
# Integration harnesses may replace this marker with bounded overrides.
# STORAGE_SCALE_TEST_INTEGRATION_OVERRIDES
source "${SCALE_TEST_BASE}/lib/env_base.sh"
