# The phase-6 coordinator supplies the command and creates this Job. Keeping
# the complete hardened resource template checked in here prevents drift
# between lifecycle foundations and the later benchmark implementation.
apiVersion: batch/v1
kind: Job
metadata:
  name: @@RESOURCE_NAME@@
  namespace: @@NAMESPACE@@
  labels:
    app.kubernetes.io/name: storage-scale-test
    app.kubernetes.io/instance: sst-elb-@@ATTEMPT_ID@@
    app.kubernetes.io/component: coordinator
    app.kubernetes.io/managed-by: storage-scale-test
    storage-scale-test.nvidia.com/benchmark: elbencho
    storage-scale-test.nvidia.com/run: @@ATTEMPT_ID@@
  annotations:
    storage-scale-test.nvidia.com/ownership: @@OWNERSHIP_NONCE@@
spec:
  backoffLimit: 0
  template:
    metadata:
      labels:
        app.kubernetes.io/name: storage-scale-test
        app.kubernetes.io/instance: sst-elb-@@ATTEMPT_ID@@
        app.kubernetes.io/component: coordinator
        app.kubernetes.io/managed-by: storage-scale-test
        storage-scale-test.nvidia.com/benchmark: elbencho
        storage-scale-test.nvidia.com/run: @@ATTEMPT_ID@@
      annotations:
        storage-scale-test.nvidia.com/ownership: @@OWNERSHIP_NONCE@@
    spec:
      automountServiceAccountToken: false
      restartPolicy: Never
      nodeName: @@COORDINATOR_NODE@@
      securityContext:
        runAsNonRoot: true
        runAsUser: @@RUN_AS_USER@@
        runAsGroup: @@RUN_AS_GROUP@@
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: coordinator
          image: @@IMAGE@@
          imagePullPolicy: @@IMAGE_PULL_POLICY@@
          command: ["/bin/bash", "-ceu", "--"]
          args:
            - >-
              exec /mnt/storage-scale-test/.storage-scale-test/runs/@@ATTEMPT_ID@@/control/coordinator.sh
              /mnt/storage-scale-test/.storage-scale-test/runs/@@ATTEMPT_ID@@/control
              /mnt/storage-scale-test/.storage-scale-test/runs/@@ATTEMPT_ID@@/state
              /tmp/storage-scale-test/@@ATTEMPT_ID@@
              @@ATTEMPT_ID@@
          env:
            - name: KUBECTL_COORDINATOR_POD_NODE
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: KUBECTL_COORDINATOR_POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: KUBECTL_COORDINATOR_POD_UID
              valueFrom:
                fieldRef:
                  fieldPath: metadata.uid
            - name: KUBECTL_COORDINATOR_POD_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: storage
              mountPath: /mnt/storage-scale-test
            - name: scratch
              mountPath: /tmp/storage-scale-test
      volumes:
        - name: storage
          persistentVolumeClaim:
            claimName: @@PVC_NAME@@
        - name: scratch
          emptyDir: {}
