kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
name: @@CLUSTER_NAME@@
networking:
  disableDefaultCNI: true
  podSubnet: 192.168.0.0/16
nodes:
  - role: control-plane
    labels:
      storage-scale-test/login: "true"
    extraMounts:
      - hostPath: @@SHARED_ROOT@@
        containerPath: /var/local/storage-scale-shared
@@KMSG_MOUNT@@
  - role: worker
    labels:
      storage-scale-test/target: "true"
    extraMounts:
      - hostPath: @@SHARED_ROOT@@
        containerPath: /var/local/storage-scale-shared
@@KMSG_MOUNT@@
  - role: worker
    labels:
      storage-scale-test/target: "true"
    extraMounts:
      - hostPath: @@SHARED_ROOT@@
        containerPath: /var/local/storage-scale-shared
@@KMSG_MOUNT@@
