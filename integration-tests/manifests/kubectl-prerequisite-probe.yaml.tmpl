apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: storage-scale-kubectl-probe-workers
  namespace: @@NAMESPACE@@
  labels:
    app.kubernetes.io/name: storage-scale-kubectl-probe
    app.kubernetes.io/component: worker
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: storage-scale-kubectl-probe
      app.kubernetes.io/component: worker
  template:
    metadata:
      labels:
        app.kubernetes.io/name: storage-scale-kubectl-probe
        app.kubernetes.io/component: worker
    spec:
      automountServiceAccountToken: false
      nodeSelector:
        storage-scale-test/target: "true"
      securityContext:
        runAsNonRoot: true
        runAsUser: 2000
        runAsGroup: 2000
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: elbencho
          image: @@ELBENCHO_IMAGE@@
          imagePullPolicy: Never
          command: ["/bin/bash", "-ceu", "--"]
          args:
            - |
              test "$(id -u)" = 2000
              test "$(id -g)" = 2000
              umask 077
              mkdir -p -- /mnt/storage-scale-test/.kubectl-prerequisite-probe/@@PROBE_TOKEN@@
              printf '%s %s\n' '@@PROBE_TOKEN@@' "$NODE_NAME" > "/mnt/storage-scale-test/.kubectl-prerequisite-probe/@@PROBE_TOKEN@@/$NODE_NAME"
              exec /usr/bin/elbencho --service --foreground --port 1611
          env:
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          ports:
            - name: status
              containerPort: 1611
              protocol: TCP
          readinessProbe:
            exec:
              command:
                - /bin/bash
                - -ceu
                - |
                  exec 3<>/dev/tcp/127.0.0.1/1611
                  printf 'GET /status HTTP/1.0\r\nHost: 127.0.0.1:1611\r\n\r\n' >&3
                  IFS= read -r -t 2 response <&3
                  exec 3>&-
                  [[ "$response" == *" 200 "* ]]
            initialDelaySeconds: 1
            periodSeconds: 1
            timeoutSeconds: 3
            failureThreshold: 30
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: storage
              mountPath: /mnt/storage-scale-test
      volumes:
        - name: storage
          persistentVolumeClaim:
            claimName: storage-test-rwx
---
apiVersion: v1
kind: Pod
metadata:
  name: storage-scale-kubectl-probe-coordinator
  namespace: @@NAMESPACE@@
  labels:
    app.kubernetes.io/name: storage-scale-kubectl-probe
    app.kubernetes.io/component: coordinator
spec:
  automountServiceAccountToken: false
  restartPolicy: Never
  nodeSelector:
    storage-scale-test/login: "true"
  securityContext:
    runAsNonRoot: true
    runAsUser: 2000
    runAsGroup: 2000
    seccompProfile:
      type: RuntimeDefault
  containers:
    - name: coordinator
      image: @@ELBENCHO_IMAGE@@
      imagePullPolicy: Never
      command: ["/bin/bash", "-ceu", "--"]
      args:
        - |
          test "$(id -u)" = 2000
          test "$(id -g)" = 2000
          exec sleep infinity
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop: ["ALL"]
      volumeMounts:
        - name: storage
          mountPath: /mnt/storage-scale-test
  volumes:
    - name: storage
      persistentVolumeClaim:
        claimName: storage-test-rwx
---
